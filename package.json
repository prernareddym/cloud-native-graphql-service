{
  "name": "cloud-native-graphql-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Bookshelf GraphQL API (Node.js, Express, TypeScript) with Docker, Kubernetes manifests and Terraform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "jest",
    "test:ci": "jest --ci --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "express": "^5.3.0",
    "graphql": "^16.14.2",
    "graphql-http": "^1.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
